[app]

title = Base63
package.name = base63
package.domain = org.base63

source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,atlas,ttf,json

version = 1.0

requirements = python3,kivy

orientation = portrait

fullscreen = 0

icon.filename =

presplash.filename =

android.permissions = INTERNET

android.api = 33
android.minapi = 21
android.ndk = 25b

android.archs = arm64-v8a, armeabi-v7a

android.allow_backup = True

log_level = 2

[buildozer]

log_level = 2

warn_on_root = 1
